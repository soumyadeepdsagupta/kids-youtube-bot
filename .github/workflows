name: 🎬 Daily Kids Video

on:
  schedule:
    - cron: '0 10 * * *'    # Every day at 10:00 AM UTC
  workflow_dispatch:          # Also allows manual "Run workflow" button in GitHub

jobs:
  generate-and-upload:
    name: Generate & Upload Video
    runs-on: ubuntu-latest
    timeout-minutes: 30        # Safety net — full pipeline rarely exceeds 10 min

    steps:
      # ── 1. Checkout repo ───────────────────────────────────────────────────
      - name: Checkout repository
        uses: actions/checkout@v4

      # ── 2. Python ─────────────────────────────────────────────────────────
      - name: Set up Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'
          cache: 'pip'

      # ── 3. System packages (FFmpeg + fonts) ───────────────────────────────
      - name: Install system packages
        run: |
          sudo apt-get update -q
          sudo apt-get install -y --no-install-recommends \
            ffmpeg \
            fonts-dejavu-core \
            fonts-liberation

      # ── 4. Python dependencies ────────────────────────────────────────────
      - name: Install Python dependencies
        run: pip install --upgrade pip && pip install -r requirements.txt

      # ── 5. Run pipeline ───────────────────────────────────────────────────
      - name: Run video pipeline
        env:
          GROQ_API_KEY:             ${{ secrets.GROQ_API_KEY }}
          YOUTUBE_CLIENT_ID:        ${{ secrets.YOUTUBE_CLIENT_ID }}
          YOUTUBE_CLIENT_SECRET:    ${{ secrets.YOUTUBE_CLIENT_SECRET }}
          YOUTUBE_REFRESH_TOKEN:    ${{ secrets.YOUTUBE_REFRESH_TOKEN }}
        run: python main.py
